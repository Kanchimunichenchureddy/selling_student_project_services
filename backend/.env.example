APP_NAME="Student Project Portal API"
ENVIRONMENT="development"

# Comma-separated list for production, for example:
# ALLOWED_ORIGINS="https://your-frontend.vercel.app,http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# Google Sheets sink
SPREADSHEET_ID=""
SHEET_NAME="Sheet1"
GOOGLE_SERVICE_ACCOUNT_JSON=""

# Local fallback file used when Google Sheets is unavailable
LEAD_BACKUP_PATH="data/lead_backup.jsonl"

# SMTP email confirmation
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SENDER_EMAIL=""
WHATSAPP_NUMBER="917396100453"

# Slack/Discord/Zapier/custom webhook
NOTIFICATION_WEBHOOK_URL=""

# Lightweight anti-spam controls
RATE_LIMIT_WINDOW_SECONDS=600
RATE_LIMIT_MAX_SUBMISSIONS=5
